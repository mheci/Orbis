{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/astarling-x/g-container/src/domains/schema.json",
  "title": "G-Container domain set",
  "type": "object",
  "required": ["id", "title", "updated"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "defaultEnabled": { "type": "boolean" },
    "domains": { "type": "array", "items": { "type": "string" } },
    "gtldDomains": { "type": "array", "items": { "type": "string" } },
    "brandTLDs": { "type": "array", "items": { "type": "string" } },
    "suffixes": { "type": "array", "items": { "type": "string" } },
    "bases": { "type": "array", "items": { "type": "string" } },
    "ccTLDBases": { "type": "array", "items": { "type": "string" } },
    "alwaysOn": { "type": "array", "items": { "type": "string" } },
    "redirectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host", "path", "params"],
        "properties": {
          "host": { "type": "string" },
          "path": { "type": "string" },
          "params": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "neverContainerize": { "type": "array", "items": { "type": "string" } },
    "oauthPaths": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
